# `npm run dev` talks to the local dev server (dev-server/: game room + mock Rastaar backend).
# Start both with `npm run dev:all`. Sign in with any phone number, code 1234.
# To develop against the real platform, put your own values in .env.development.local.
VITE_API_BASE_URL=http://localhost:2567
VITE_API_AUTH=bearer
VITE_WS_URL=ws://localhost:2567
