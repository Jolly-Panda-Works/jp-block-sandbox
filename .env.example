# ---- Rastaar backend (issues game tokens) ----
# Origin of the Rastaar backend. The game calls
#   POST {VITE_API_BASE_URL}{VITE_TOKEN_PATH}  { multiplayerId }  →  { wsUrl, jwt, expiresAt }   (maybe inside { code, data })
VITE_API_BASE_URL=
VITE_TOKEN_PATH=/api/v1/client/realtime/token

# How the token request proves who the player is (the normal Rastaar app login):
#   cookie → fetch(..., { credentials: 'include' })
#   bearer → Authorization: Bearer <app access token>, passed once as ?token=… (then kept in localStorage)
VITE_API_AUTH=cookie

# ---- Game server (Rastaar) ----
# Used if the token response has no wsUrl, or when a jwt is passed directly with ?jwt=…
VITE_WS_URL=wss://gameserver.rastar.ir
# Game key on the platform (= Colyseus room name).
VITE_ROOM_NAME=blocksy

# ---- Sign-in and room browser (see docs/BACKEND-API.md; defaults shown) ----
# VITE_AUTH_GUEST_PATH=/api/v1/auth/guest
# VITE_ME_PATH=/api/v1/client/me
# VITE_ROOMS_PATH=/api/v1/client/multiplayer/games/{game}/matches
# VITE_ROOM_PATH=/api/v1/client/multiplayer/matches/{id}
