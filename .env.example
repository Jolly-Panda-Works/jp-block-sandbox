# ---- Rastaar platform backend (issues realtime tokens) ----
# The game calls POST {VITE_API_BASE_URL}/client/realtime/token  { multiplayerId }  →  { wsUrl, jwt }
VITE_API_BASE_URL=

# How the token request authenticates with the backend:
#   cookie → fetch(..., { credentials: 'include' })   (default)
#   bearer → Authorization: Bearer <token>; token from ?token=... or localStorage "blocksy.authToken"
VITE_API_AUTH=cookie

# Which multiplayer session to join (players with the same id share a room). Also ?multiplayerId=...
VITE_MULTIPLAYER_ID=public

# ---- Game server (Rastaar) ----
# Used when the token response has no wsUrl, or when a token is passed directly with ?jwt=...
VITE_WS_URL=wss://gameserver.rastar.ir
# Game key of the Blocksy game on the platform (= Colyseus room name).
VITE_ROOM_NAME=blocksy
