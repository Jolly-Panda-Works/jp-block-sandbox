{
  "name": "@jp/blocksy",
  "version": "0.3.0",
  "private": true,
  "description": "Blocksy \u2014 multiplayer block-building game client (React Three Fiber).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test shared/test/*.test.ts",
    "shared:hash": "node shared/hash.mjs",
    "dev:server": "npm --prefix dev-server run dev",
    "dev:all": "concurrently -k -n server,game -c cyan,magenta \"npm run dev:server\" \"npm run dev\"",
    "setup": "npm install && npm --prefix dev-server install",
    "build:pages": "vite build",
    "test:client": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "colyseus.js": "^0.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "concurrently": "^9.0.1"
  }
}