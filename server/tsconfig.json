{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "paths": {
      "@jp/block-sandbox-shared": [
        "../shared/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
